# Ma tran thoi gian di chuyen + routing (https://myprojects.geoapify.com)
GEOAPIFY_API_KEY=
# Gemini: gan tag dia diem + sinh mo ta hoat dong (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# SerpAPI: crawl du lieu dia diem (https://serpapi.com)
SERP_API_KEY=
# WeatherAPI: du bao thoi tiet theo ngay (https://www.weatherapi.com)
WEATHER_API_KEY=
