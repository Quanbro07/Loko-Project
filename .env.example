# ============================================================
# Bien moi truong cho docker-compose (thu muc goc)
# Copy file nay thanh .env roi dien gia tri that.
#   cp .env.example .env
# File .env KHONG duoc commit (da nam trong .gitignore).
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=doi_mat_khau_nay
POSTGRES_DB=loko_project

# --- JWT ---
# Khoa ky HS512 dang base64. Tao khoa moi bang:
#   openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=thay_bang_khoa_base64_64_byte

# --- Cong publish ra host ---
# Chi doi khi cong mac dinh da bi mot stack khac tren may chiem.
# Cac service goi nhau qua mang noi bo Docker nen doi o day khong anh huong gi.
FRONTEND_PORT=3000
BACKEND_PORT=8080
AI_SERVICE_PORT=8000
POSTGRES_PORT=5332
REDIS_PORT=6379
