# ============================================================
# Bien moi truong rieng cua Backend (Spring Boot).
# Copy thanh Backend/.env roi dien gia tri that.
# ============================================================

# --- SMTP dung cho email xac thuc tai khoan ---
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=email_cua_ban@gmail.com
# Gmail: dung App Password (16 ky tu), khong dung mat khau dang nhap
SPRING_MAIL_PASSWORD=app_password_cua_ban

# --- JWT ---
# Khoa ky HS512 dang base64. Bat buoc, khong co gia tri mac dinh trong source.
# Tao khoa moi:  openssl rand -base64 64 | tr -d '
'
JWT_SECRET=thay_bang_khoa_base64_64_byte
